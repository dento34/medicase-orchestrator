# MediCase Orchestrator — Environment Variables (TEMPLATE)
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — your secrets will NOT be pushed to GitHub.
# This `.env.example` is committed so future developers know what's needed.
#
# NEVER paste real tokens or keys into this file.

# =============================================================================
# UiPath Automation Cloud
# =============================================================================
# Personal Access Token created at:
#   Automation Cloud → Preferences → Personal Access Tokens → Generate
# Scopes granted (per our plan):
#   - Orchestrator API Access
#   - Maestro API Access
#   - StudioWeb API Access
#   - Platform Management API Access
#   - Document Understanding
#   - AICenter API Access
#   - Context Grounding API Access
#   - Resource Catalog Service Api
UIPATH_TENANT_URL=https://staging.uipath.com/hackathon26_137
UIPATH_PAT=uip_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UIPATH_ORG_NAME=hackathon26_137
UIPATH_TENANT_NAME=DefaultTenant

# Optional — only needed if calling Orchestrator/folder-scoped APIs
UIPATH_FOLDER_ID=
UIPATH_ORG_UNIT_ID=

# =============================================================================
# Anthropic (Claude) — for LanguageAgent + SummaryAgent + dev-time Claude Code
# =============================================================================
# Get key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# =============================================================================
# Real-Time Search & external APIs (RTSLookupAgent)
# =============================================================================
# OpenStreetMap (free, no key needed) — for AED nodes
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# NIH RxNav (free, no key) — drug interaction lookup
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# Mock ambulance ETA (replace with event ops API in production)
AMBULANCE_API_URL=http://localhost:3001/mock/ambulance
AMBULANCE_API_KEY=

# =============================================================================
# Patient mini web app (Next.js / Vercel)
# =============================================================================
# Public — safe to expose to browser
NEXT_PUBLIC_CASE_API_URL=http://localhost:3000/api
NEXT_PUBLIC_TTS_PROVIDER=browser

# Server-side only — never expose to browser
CASE_SIGNING_SECRET=replace_me_with_32byte_random_string

# =============================================================================
# Slack / Teams handoff (volunteer + specialist channels)
# =============================================================================
# Optional during hackathon — can mock; needed for real deployment
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_MEDIC_CARDIAC_CHANNEL_ID=

# =============================================================================
# Storage (audit log + anonymized case memory)
# =============================================================================
# For demo: SQLite locally is fine
DATABASE_URL=sqlite:///./medicase.db

# For Vector store (Context Grounding via UiPath or fallback)
USE_UIPATH_CONTEXT_GROUNDING=true

# =============================================================================
# Development flags
# =============================================================================
LOG_LEVEL=INFO
ENV=development
DEMO_MODE=true
